# Base URL for the backend API. Leave empty to use same-origin requests that
# are forwarded to the backend by the Vite dev proxy (recommended for local
# development, avoids CORS). Set to an absolute URL only when the API is served
# from a different origin in production.
VITE_API_BASE_URL=""

# --- Production only (`npm run build` + `npm start`, e.g. on Railway) ---
# Origin of the backend API that the built Node server reverse-proxies `/api/*`
# requests to. This keeps the browser talking to a single same-origin host (no
# CORS, the session cookie keeps working) and is the production equivalent of
# the Vite dev proxy. Set it to the backend's URL (e.g. its Railway internal or
# public URL). Defaults to http://localhost:3000.
API_PROXY_TARGET="http://localhost:3000"